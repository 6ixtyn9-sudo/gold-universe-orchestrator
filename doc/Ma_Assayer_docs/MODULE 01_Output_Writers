 // ============================================================================
// ROBUST: Output_.writeSummary
// - Case-insensitive source matching for robust counting
// - Only counts all-quarter rows to avoid per-quarter duplicates
// - Splits low-performing counts by source with fallback for unknown
// ============================================================================
/**
 * Write summary sheet with updated labels reflecting tier/quarter granularity
 */
writeSummary(ss, allBets, globalStats, leagueAssay, edges, logSummary) {
  if (!this.log) this.init();
  Log_.section("Writing Summary");

  const sheet = this.getOrCreateSheet(ss, Config_.sheets.summary);
  sheet.clear();
  sheet.clearFormats(); // prevent stale 0.00% format bleeding onto integer columns

  const combos = Object.values(leagueAssay || {});
  const allQuarterCombos = combos.filter(l => l?.quarter == null);

  const goldEdges = (Array.isArray(edges) ? edges : []).filter(e => e.grade === "GOLD" || e.grade === "PLATINUM");
  const goldCombos = allQuarterCombos.filter(l => l.grade === "GOLD" || l.grade === "PLATINUM");
  const toxicCombos = allQuarterCombos.filter(l => l.grade === "CHARCOAL" || l.isToxic);

  const uniqueLeagues = new Set(allQuarterCombos.map(l => l.league).filter(Boolean)).size;
  const uniqueAllQuarterKeys = allQuarterCombos.length;

  // ── Helper: format integer counts with commas ──
  const fmt = n => (typeof n === 'number') ? n.toLocaleString('en-US') : String(n || 0);

  // ── Canonical decisive bet set ──
  const decisiveBets = (allBets || []).filter(b => b.result === 0 || b.result === 1);
  const overallDecisive = decisiveBets.length;
  let overallWins = 0;
  let overallLosses = 0;
  decisiveBets.forEach(b => {
    if (b.result === 1) overallWins++;
    if (b.result === 0) overallLosses++;
  });

  // ── BY TYPE aggregation ──
  const byType = {};
  
  // 1. Tally combos from leagueAssay to preserve minimal drift
  allQuarterCombos.forEach(l => {
    const rawT = l.typeKey || l.type;
    // Do not allow missing typeKeys to silently map into "ALL", use "UNKNOWN"
    const t = rawT && rawT.toUpperCase() !== "ALL" ? rawT.toUpperCase() : "UNKNOWN";
    if (!byType[t]) byType[t] = { combos: 0, decisive: 0, wins: 0, losses: 0 };
    // Only tally if it wasn't an aggregate row itself (which often lacks typeKey or has "ALL")
    if (rawT && rawT.toUpperCase() !== "ALL") {
      byType[t].combos++;
    }
  });

  // 2. Tally decisive/wins/losses from bet-universe
  decisiveBets.forEach(b => {
    const rawT = b.typeKey || b.type;
    const t = rawT && rawT.toUpperCase() !== "ALL" ? rawT.toUpperCase() : "UNKNOWN";
    if (!byType[t]) byType[t] = { combos: 0, decisive: 0, wins: 0, losses: 0 };
    byType[t].decisive++;
    if (b.result === 1) byType[t].wins++;
    if (b.result === 0) byType[t].losses++;
  });

  // 3. Add the explicit "ALL" rollup row
  byType["ALL"] = {
    combos: allQuarterCombos.length, // total combos as a baseline
    decisive: overallDecisive,
    wins: overallWins,
    losses: overallLosses
  };

  const byTypeRows = Object.entries(byType)
    .sort((a, b) => {
      if (a[0] === "ALL") return -1;
      if (b[0] === "ALL") return 1;
      return b[1].decisive - a[1].decisive;
    })
    .map(([t, s]) => {
      const wr = s.decisive > 0 ? s.wins / s.decisive : 0;
      return [t, fmt(s.combos), fmt(s.decisive), fmt(s.wins), fmt(s.losses), Stats_.pct(wr), Stats_.getGrade(wr, s.decisive)];
    });

  // ── BY TYPE × TIER aggregation ──
  const byTypeTierMap = {};
  decisiveBets.forEach(b => {
    const rawT = b.typeKey || b.type;
    const typeKey = rawT && rawT.toUpperCase() !== "ALL" ? rawT.toUpperCase() : "UNKNOWN";
    const tier = (b.tier || "UNKNOWN").toUpperCase();
    const k = `${typeKey}___${tier}`;
    if (!byTypeTierMap[k]) byTypeTierMap[k] = { typeKey, tier, decisive: 0, wins: 0, losses: 0 };
    byTypeTierMap[k].decisive++;
    if (b.result === 1) byTypeTierMap[k].wins++;
    if (b.result === 0) byTypeTierMap[k].losses++;
  });

  const tierOrder = ["ELITE", "STRONG", "MEDIUM", "EVEN", "WEAK", "UNKNOWN"];
  const byTypeTierRows = Object.values(byTypeTierMap)
    .sort((a, b) => {
      if (a.typeKey !== b.typeKey) return a.typeKey.localeCompare(b.typeKey);
      const ai = tierOrder.indexOf(a.tier);
      const bi = tierOrder.indexOf(b.tier);
      return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
    })
    .map(s => {
      const wr = s.decisive > 0 ? s.wins / s.decisive : 0;
      return [s.typeKey, s.tier, fmt(s.decisive), fmt(s.wins), fmt(s.losses), Stats_.pct(wr), Stats_.getGrade(wr, s.decisive)];
    });

  // ── ROBBER DEEP DIVE aggregation ──
  const robberMap = {};
  const robbers = (allBets || []).filter(b => {
    const typeKey = (b.typeKey || b.type || "").toUpperCase();
    return typeKey.includes("ROBBER");
  });

  robbers.forEach(b => {
    if (b.result !== 0 && b.result !== 1) return; // Only decisive
    
    let band = "missing odds";
    const o = parseFloat(b.odds);
    if (!isNaN(o) && o > 0) {
      if (o < 1.80) band = "<1.80";
      else if (o <= 2.20) band = "1.80-2.20";
      else if (o <= 2.75) band = "2.21-2.75";
      else if (o <= 3.50) band = "2.76-3.50";
      else if (o <= 5.00) band = "3.51-5.00";
      else band = "5.01+";
    }
    
    const tier = (b.tier || "UNKNOWN").toUpperCase();
    const k = `${tier}___${band}`;
    
    if (!robberMap[k]) robberMap[k] = { tier, band, decisive: 0, wins: 0, losses: 0, profit: 0, hasOddsCount: 0 };
    
    robberMap[k].decisive++;
    if (b.result === 1) robberMap[k].wins++;
    if (b.result === 0) robberMap[k].losses++;
    
    if (band !== "missing odds") {
      robberMap[k].hasOddsCount++;
      if (b.result === 1) robberMap[k].profit += (o - 1);
      else if (b.result === 0) robberMap[k].profit -= 1;
    }
  });

  const bandOrder = ["<1.80", "1.80-2.20", "2.21-2.75", "2.76-3.50", "3.51-5.00", "5.01+", "missing odds"];
  const robberRows = Object.values(robberMap)
    .sort((a, b) => {
      const ai = tierOrder.indexOf(a.tier);
      const bi = tierOrder.indexOf(b.tier);
      if (ai !== bi) return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
      
      const bandAi = bandOrder.indexOf(a.band);
      const bandBi = bandOrder.indexOf(b.band);
      return (bandAi === -1 ? 99 : bandAi) - (bandBi === -1 ? 99 : bandBi);
    })
    .map(s => {
      const wr = s.decisive > 0 ? s.wins / s.decisive : 0;
      let roiStr = "N/A";
      if (s.band !== "missing odds" && s.hasOddsCount > 0) {
        const roi = s.profit / s.hasOddsCount;
        roiStr = Stats_.lift(roi);
      }
      return [s.tier, s.band, fmt(s.decisive), fmt(s.wins), fmt(s.losses), Stats_.pct(wr), Stats_.getGrade(wr, s.decisive), roiStr];
    });

  // ── BY TIER aggregation ──
  const byTier = {};
  allQuarterCombos.forEach(l => {
    const t = (l.tier || "UNKNOWN").toUpperCase();
    if (!byTier[t]) byTier[t] = { combos: 0, decisive: 0, wins: 0, losses: 0 };
    byTier[t].combos++;
  });
  
  decisiveBets.forEach(b => {
    const t = (b.tier || "UNKNOWN").toUpperCase();
    if (!byTier[t]) byTier[t] = { combos: 0, decisive: 0, wins: 0, losses: 0 };
    byTier[t].decisive++;
    if (b.result === 1) byTier[t].wins++;
    if (b.result === 0) byTier[t].losses++;
  });
  
  const byTierRows = Object.entries(byTier)
    .sort((a, b) => {
      const ai = tierOrder.indexOf(a[0]);
      const bi = tierOrder.indexOf(b[0]);
      return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
    })
    .map(([t, s]) => {
      const wr = s.decisive > 0 ? s.wins / s.decisive : 0;
      return [t, fmt(s.combos), fmt(s.decisive), fmt(s.wins), fmt(s.losses), Stats_.pct(wr), Stats_.getGrade(wr, s.decisive)];
    });

  // Assemble Data
  let data = [
    [`⚗️ MA ASSAYER SUMMARY — v${Config_.version}`],
    [`Generated: ${Utils_.formatDate(new Date(), "yyyy-MM-dd HH:mm:ss")}`],
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["OVERALL PERFORMANCE"],
    [""],
    ["Metric", "Value"],
    ["Total Bets Analyzed", fmt(globalStats?.total)],
    ["Decisive Bets",        fmt(globalStats?.decisive)],
    ["Wins",                 fmt(globalStats?.wins)],
    ["Losses",               fmt(globalStats?.losses)],
    ["Pushes",               fmt(globalStats?.pushes)],
    ["Win Rate",             Stats_.pct(globalStats?.winRate || 0)],
    ["Grade", `${Stats_.getGradeSymbol(globalStats?.winRate || 0)} ${Stats_.getGrade(globalStats?.winRate || 0, globalStats?.decisive || 0)}`],
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["BY TYPE (Fleet)"],
    [""],
    ["Bet Type", "Combos", "Decisive", "Wins", "Losses", "Win Rate", "Grade"]
  ];
  
  data = data.concat(byTypeRows);
  
  data = data.concat([
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["BY TYPE × TIER (Fleet)"],
    [""],
    ["Bet Type", "Tier", "N", "Wins", "Losses", "Win Rate", "Grade"]
  ]);
  
  data = data.concat(byTypeTierRows);
  
  data = data.concat([
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["ROBBER DEEP DIVE"],
    [""],
    ["Tier", "Odds Band", "N", "Wins", "Losses", "Win Rate", "Grade", "ROI"]
  ]);
  
  data = data.concat(robberRows);
  
  data = data.concat([
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["ACCURACY BY TIER"],
    [""],
    ["Tier", "Combos", "Decisive", "Wins", "Losses", "Win Rate", "Grade"]
  ]);
  
  data = data.concat(byTierRows);
  
  data = data.concat([
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["DISCOVERY SUMMARY"],
    [""],
    ["Total Edges Discovered",                          fmt(Array.isArray(edges) ? edges.length : 0)],
    ["Gold/Platinum Edges",                             fmt(goldEdges.length)],
    ["Unique Leagues (All-Quarter)",                    fmt(uniqueLeagues)],
    ["All-Quarter Combos (League+Source+Gender+Tier)",  fmt(uniqueAllQuarterKeys)],
    ["Gold/Platinum Combos (All-Quarter)",              fmt(goldCombos.length)],
    ["Low-performing/Toxic Combos (All-Quarter)",       fmt(toxicCombos.length)]
  ]);

  // ── INTEGRITY / PROOF CALCULATION ──
  const proofLines = [];
  let proofPass = true;
  const logProof = (name, expected, actual) => {
    const isPass = expected === actual;
    if (!isPass) proofPass = false;
    const delta = actual - expected;
    const line = isPass 
      ? `${name}: PASS (${expected} == ${actual})`
      : `${name}: FAIL (expected ${expected} got ${actual}, delta=${delta})`;
    proofLines.push(line);
    if (this.log) {
      if (isPass) this.log.info(`[INTEGRITY] ${line}`);
      else this.log.error(`[INTEGRITY] ${line}`);
    }
  };

  logProof("I1 Wins+Losses vs Decisive", overallDecisive, overallWins + overallLosses);

  const byTypeAll = byType["ALL"] || {decisive: 0, wins: 0, losses: 0};
  logProof("I2 BY_TYPE_ALL.decisive vs OVERALL", overallDecisive, byTypeAll.decisive);
  logProof("I2 BY_TYPE_ALL.wins vs OVERALL", overallWins, byTypeAll.wins);
  logProof("I2 BY_TYPE_ALL.losses vs OVERALL", overallLosses, byTypeAll.losses);

  let sumExclAllDecisive = 0, sumExclAllWins = 0, sumExclAllLosses = 0;
  Object.keys(byType).forEach(t => {
    if (t !== "ALL") {
      sumExclAllDecisive += byType[t].decisive;
      sumExclAllWins += byType[t].wins;
      sumExclAllLosses += byType[t].losses;
    }
  });
  logProof("I3 SUM_BY_TYPE_EXCL_ALL.decisive vs OVERALL", overallDecisive, sumExclAllDecisive);
  logProof("I3 SUM_BY_TYPE_EXCL_ALL.wins vs OVERALL", overallWins, sumExclAllWins);
  logProof("I3 SUM_BY_TYPE_EXCL_ALL.losses vs OVERALL", overallLosses, sumExclAllLosses);

  let sumTierDecisive = 0, sumTierWins = 0, sumTierLosses = 0;
  Object.values(byTypeTierMap).forEach(s => {
    sumTierDecisive += s.decisive;
    sumTierWins += s.wins;
    sumTierLosses += s.losses;
  });
  logProof("I4 SUM_BY_TYPE_TIER.decisive vs OVERALL", overallDecisive, sumTierDecisive);
  logProof("I4 SUM_BY_TYPE_TIER.wins vs OVERALL", overallWins, sumTierWins);
  logProof("I4 SUM_BY_TYPE_TIER.losses vs OVERALL", overallLosses, sumTierLosses);

  Object.keys(byType).forEach(t => {
    if (t === "ALL") return;
    let tTierDec = 0, tTierWins = 0, tTierLoss = 0;
    Object.values(byTypeTierMap).forEach(s => {
      if (s.typeKey === t) {
        tTierDec += s.decisive;
        tTierWins += s.wins;
        tTierLoss += s.losses;
      }
    });
    const match = (byType[t].decisive === tTierDec) && (byType[t].wins === tTierWins) && (byType[t].losses === tTierLoss);
    if (!match) {
      logProof(`I5 Mismatch for typeKey=${t}`, byType[t].decisive, tTierDec);
    }
  });
  if (proofPass) {
    logProof("I5 All typeKeys match their tier sum", 1, 1);
  }

  let sumByTierDecisive = 0, sumByTierWins = 0, sumByTierLosses = 0;
  Object.values(byTier).forEach(s => {
    sumByTierDecisive += s.decisive;
    sumByTierWins += s.wins;
    sumByTierLosses += s.losses;
  });
  logProof("I6 SUM_BY_TIER.decisive vs OVERALL", overallDecisive, sumByTierDecisive);
  logProof("I6 SUM_BY_TIER.wins vs OVERALL", overallWins, sumByTierWins);
  logProof("I6 SUM_BY_TIER.losses vs OVERALL", overallLosses, sumByTierLosses);

  data = data.concat([
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["INTEGRITY / PROOF"],
    [""]
  ]);
  proofLines.forEach(line => {
    data.push([line]);
  });

  data = data.concat([
    [""],
    ["═══════════════════════════════════════════════════════════"],
    ["EXECUTION STATS"],
    [""],
    ["Elapsed Time",  `${logSummary?.elapsed || 0}s`],
    ["Warnings",      fmt(logSummary?.warnings)],
    ["Errors",        fmt(logSummary?.errors)],
    ["Session ID",    logSummary?.sessionId || "N/A"]
  ]);

  const maxCols = data.reduce((m, row) => Math.max(m, Array.isArray(row) ? row.length : 1), 4);

  const formattedData = data.map(row => {
    const arr = Array.isArray(row) ? row.slice() : [row];
    while (arr.length < maxCols) arr.push("");
    return arr;
  });

  sheet.getRange(1, 1, formattedData.length, maxCols).setValues(formattedData);
  sheet.getRange("A1").setFontSize(14).setFontWeight("bold");

  this.autoResize(sheet);

  this.log.success("Summary written");
  Log_.sectionEnd("Writing Summary");
},

// =======================================================
// PATCH: Output_.writeTeamAssay
// =======================================================
writeTeamAssay(ss, teamAssay) {
  if (!this.log) this.init();
  Log_.section("Writing Team Assay");

  const sheetName =
    (Config_.sheets && Config_.sheets.teamAssay) ? Config_.sheets.teamAssay : "MA_TeamAssay";

  const sheet = this.getOrCreateSheet(ss, sheetName);

  const headers = [
    "Team", "Quarter", "N", "Wins", "Losses",
    "Shrunk WR", "Lift", "Grade", "Toxic", "Elite", "Leagues"
  ];

  this.formatHeader(sheet, headers);

  const rows = Object.entries(teamAssay || {}).map(([k, v]) => {
    const isQuarterKey = k.includes("__Q");
    const team = isQuarterKey ? k.split("__Q")[0] : (v.team || k);
    const quarter = v.quarterLabel || (isQuarterKey ? `Q${k.split("__Q")[1]}` : "All");

    return [
      team,
      quarter,
      v.decisive || 0,
      v.wins || 0,
      v.losses || 0,
      // Store raw decimal — 0.00% format applied below
      typeof v.shrunkRate === 'number' ? v.shrunkRate : 0,
      Stats_.lift(v.lift || 0),
      `${v.gradeSymbol || ''} ${v.grade || ''}`.trim(),
      v.isToxic ? '⛔' : '',
      v.isElite ? '💎' : '',
      Array.isArray(v.leagues) ? v.leagues.join(', ') : ''
    ];
  });

  // Sort: Elite first, then Toxic, then by Shrunk WR (desc)
  rows.sort((a, b) => {
    const eliteA = a[9] ? 1 : 0, eliteB = b[9] ? 1 : 0;
    if (eliteB !== eliteA) return eliteB - eliteA;

    const toxicA = a[8] ? 1 : 0, toxicB = b[8] ? 1 : 0;
    if (toxicB !== toxicA) return toxicB - toxicA;

    const wrA = parseFloat(String(a[5]).replace("%", "")) || 0;
    const wrB = parseFloat(String(b[5]).replace("%", "")) || 0;
    return wrB - wrA;
  });

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
    // Apply 0.00% number format to Shrunk WR column (col 6, 1-indexed)
    const wrCol = headers.indexOf('Shrunk WR') + 1;
    if (wrCol > 0) sheet.getRange(2, wrCol, rows.length, 1).setNumberFormat('0.00%');
  }

  this.autoResize(sheet);
  this.log.success(`Team assay written: ${rows.length} rows`);
  Log_.sectionEnd("Writing Team Assay");
},

// =======================================================
// PATCH: Output_.writeMatchupAssay (Team × Opponent)
// =======================================================
writeMatchupAssay(ss, matchupAssay) {
  if (!this.log) this.init();
  Log_.section("Writing Matchup Assay");

  const sheetName =
    (Config_.sheets && Config_.sheets.matchupAssay) ? Config_.sheets.matchupAssay : "MA_MatchupAssay";

  const sheet = this.getOrCreateSheet(ss, sheetName);

  const headers = [
    "Backed", "Opponent", "Quarter",
    "N", "Wins", "Losses",
    "Shrunk WR", "Lift", "Grade", "Toxic", "Elite", "Leagues"
  ];

  this.formatHeader(sheet, headers);

  const rows = Object.entries(matchupAssay || {}).map(([k, v]) => {
    const isQuarterKey = k.includes("__Q");
    const baseKey = isQuarterKey ? k.split("__Q")[0] : (v.matchupKey || k);

    const parts = String(baseKey || "").split("__VS__");
    const backed = v.backedTeam || parts[0] || "";
    const opp = v.opponentTeam || parts[1] || "";

    const quarter = v.quarterLabel || (isQuarterKey ? `Q${k.split("__Q")[1]}` : "All");

    return [
      backed,
      opp,
      quarter,
      v.decisive || 0,
      v.wins || 0,
      v.losses || 0,
      Stats_.pct(v.shrunkRate || 0),
      Stats_.lift(v.lift || 0),
      `${v.gradeSymbol || ""} ${v.grade || ""}`.trim(),
      v.isToxic ? "⛔" : "",
      v.isElite ? "💎" : "",
      Array.isArray(v.leagues) ? v.leagues.join(", ") : ""
    ];
  });

  // Sort: Elite first, then Toxic, then by Shrunk WR (desc)
  rows.sort((a, b) => {
    const eliteA = a[10] ? 1 : 0, eliteB = b[10] ? 1 : 0;
    if (eliteB !== eliteA) return eliteB - eliteA;

    const toxicA = a[9] ? 1 : 0, toxicB = b[9] ? 1 : 0;
    if (toxicB !== toxicA) return toxicB - toxicA;

    const wrA = parseFloat(String(a[6]).replace("%", "")) || 0;
    const wrB = parseFloat(String(b[6]).replace("%", "")) || 0;
    return wrB - wrA;
  });

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  this.autoResize(sheet);
  this.log.success(`Matchup assay written: ${rows.length} rows`);
  Log_.sectionEnd("Writing Matchup Assay");
},

  // ============================================================================
  // MOTHER CONTRACT: ASSAYER_EDGES
  // One row per discovered edge, dimensions broken into explicit columns
  // All rates/lift stored as decimals (0–1 scale)
  // filters_json = escape hatch for future variables
  // ============================================================================
  writeAssayerEdges(ss, edges) {
    if (!this.log) this.init();
    Log_.section("Writing ASSAYER_EDGES (Mother contract)");

    const sheet = this.getOrCreateSheet(ss, Config_.sheets.assayerEdges);
    const headers = Config_.motherContract.EDGE_COLUMNS;

    this.formatHeader(sheet, headers, {
      bgColor: "#0d2b4e",
      textColor: "#ffffff"
    });

    const now = new Date().toISOString();
    const rows = [];

    (edges || []).forEach(e => {
      const crit = e.criteria || {};

      const quarterStr = crit.quarter != null ? ("Q" + crit.quarter) : null;
      const isWomen = crit.isWomen != null ? crit.isWomen : null;

      rows.push([
        e.id,                                                        // edge_id
        e.source,                                                    // source
        e.name,                                                      // pattern
        e.discoveredAt ? e.discoveredAt.split("T")[0] : now.split("T")[0], // discovered
        now,                                                         // updated_at

        quarterStr,                                                  // quarter
        isWomen,                                                     // is_women
        crit.tier         || null,                                   // tier
        crit.side         || null,                                   // side
        crit.direction    || null,                                   // direction
        crit.confBucket   || null,                                   // conf_bucket
        crit.spreadBucket || null,                                   // spread_bucket
        crit.lineBucket   || null,                                   // line_bucket

        // ◆ PATCH v4.3.0: display-only SNIPER_MARGIN for Side edges (do not mutate criteria)
        (e.source === "Side" ? "SNIPER_MARGIN" : (crit.typeKey || null)), // type_key  ◆ PATCH v4.3.0

        JSON.stringify(crit),                                        // filters_json

        e.n,                                                         // n
        e.wins,                                                      // wins
        e.losses,                                                    // losses
        e.winRate,                                                   // win_rate
        e.lowerBound,                                                // lower_bound
        e.upperBound,                                                // upper_bound
        e.lift,                                                      // lift

        e.grade,                                                     // grade
        e.gradeSymbol,                                               // symbol
        e.reliable,                                                  // reliable
        e.sampleSize                                                 // sample_size
      ]);
    });

    if (rows.length > 0) {
      sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);

      sheet.getRange(2, 1, rows.length, 1).setNumberFormat("@");    // edge_id col
      sheet.getRange(2, 15, rows.length, 1).setNumberFormat("@");   // filters_json col (was 14, now 15)
    }

    this.autoResize(sheet);

    this.log.success("ASSAYER_EDGES written: " + rows.length + " edges");
    Log_.sectionEnd("Writing ASSAYER_EDGES");
  },

  // ============================================================================
  // MOTHER CONTRACT: ASSAYER_LEAGUE_PURITY
  // One row per league/quarter/source/gender/tier combination
  // win_rate = shrunkRate (Bayesian adjusted), decimal 0–1
  // ============================================================================
  writeAssayerLeaguePurity(ss, leagueAssay) {
    if (!this.log) this.init();
    Log_.section("Writing ASSAYER_LEAGUE_PURITY (Mother contract)");

    const sheet = this.getOrCreateSheet(ss, Config_.sheets.assayerLeaguePurity);
    const headers = Config_.motherContract.LEAGUE_COLUMNS;

    this.formatHeader(sheet, headers, {
      bgColor: "#1a3c5e",
      textColor: "#ffffff"
    });

    const now = new Date().toISOString();
    const rows = [];

    Object.values(leagueAssay || {}).forEach(l => {
      // Quarter label: null→"All", 0→"Full", 1–4→"Q1"…"Q4"
      const qLabel = l.quarter == null ? "All"
                   : l.quarter === 0   ? "Full"
                   : ("Q" + l.quarter);

      // Status derived from grade + flags (priority order)
      let status = "📊 Building";
      if (l.grade === "CHARCOAL" || l.isToxic) {
        status = "⛔ Avoid";
      } else if (l.isElite) {
        status = "🌟 Elite";
      } else if (l.isReliable) {
        status = "✅ Reliable";
      }

      rows.push([
        l.league || "",                                  // league
        qLabel,                                          // quarter
        l.source || "",                                  // source  (Side|Totals|Other)
        l.gender || (l.isWomen ? "W" : "M"),             // gender  (M|W)
        l.tier   || "UNKNOWN",                           // tier    (EVEN|MEDIUM|STRONG|UNKNOWN)
        l.typeKey || "",
        l.decisive || 0,                                 // n       (int)
        l.shrunkRate != null ? l.shrunkRate               // win_rate (decimal 0–1, Bayesian)
                             : (l.winRate || 0),
        l.grade  || "",                                  // grade   (PLATINUM…CHARCOAL)
        status,                                          // status  (display string)
        now                                              // updated_at (ISO timestamp)
      ]);
    });

    if (rows.length > 0) {
      sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
    }

    this.autoResize(sheet);

    this.log.success("ASSAYER_LEAGUE_PURITY written: " + rows.length + " rows");
    Log_.sectionEnd("Writing ASSAYER_LEAGUE_PURITY");
  },

