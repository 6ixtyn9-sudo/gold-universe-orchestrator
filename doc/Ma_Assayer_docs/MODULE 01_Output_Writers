    ["✅ KEEP — This league contributes positively to this source (Δ < -2%)"],
    ["➖ NEUTRAL — Minimal impact either way (|Δ| ≤ 2%)"],
    [""],
    ["REFERENCE:"],
    ["Global Combined Baseline:", globalWR]
