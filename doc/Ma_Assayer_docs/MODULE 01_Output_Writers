// ============================================================================
// MODULE: Output_ — Sheet Writers
// ============================================================================

const Output_ = {
  log: null,
  
  /**
   * Initialize module
   */
  init() {
    this.log = Log_.module("OUTPUT");
  },
  
  /**
   * Get or create sheet
   */
  getOrCreateSheet(ss, name) {
    if (!this.log) this.init();
    
    let sheet = ss.getSheetByName(name);
    if (!sheet) {
      sheet = ss.insertSheet(name);
      this.log.info(`Created sheet: ${name}`);
    }
    return sheet;
  },
  
  /**
   * Clear and format header row
   */
  formatHeader(sheet, headers, options = {}) {
    const {
      bgColor = Config_.colors.header,
      textColor = Config_.colors.headerText,
      freezeRows = 1
    } = options;
    
    sheet.clear();
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.getRange(1, 1, 1, headers.length)
      .setFontWeight("bold")
      .setBackground(bgColor)
      .setFontColor(textColor);
    
    if (freezeRows > 0) {
      sheet.setFrozenRows(freezeRows);
    }
    
    return sheet;
  },
  
  /**
   * Auto-resize columns
   */
  autoResize(sheet, startCol = 1, numCols = null) {
    const cols = numCols || sheet.getLastColumn();
    if (cols > 0) {
      sheet.autoResizeColumns(startCol, cols);
    }
  },
  
// ============================================================================
// ROBUST: Output_.writeVault
// - Adds Source column to Top/Low-performing tables
// - Nuanced actions: ⛔ AVOID for Charcoal, ⚠️ REVIEW for predefined toxic only
// - Clear status labels distinguishing config-based vs performance-based flags
// - 7 columns with proper padding
// ============================================================================
/**
 * Write the MA_Vault sheet with Quarter and Tier columns in tables
 */
  writeVaultFlat(ss, allBets, leagueAssay, teamAssay, matchupAssay, edges) {
    const SHEET_NAME = Config_.sheets.vault || "MA_Vault";
    const HEADERS = [
      "Bet Index (rowIndex)",
      "Source",
      "League",
      "Date",
      "Matchup",
      "Pick",
      "Type",
      "Quarter",
      "Direction",
      "Confidence",
      "Conf Bucket",
      "Grade",
      "Purity Status",
      "Backed Team",
      "Opponent",
      "Spread / Line",
      "Result / Outcome"
    ];

    let sheet = ss.getSheetByName(SHEET_NAME);
    if (!sheet) {
      sheet = ss.insertSheet(SHEET_NAME);
    } else {
      sheet.clearContents();
    }

    // Write headers
    sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
    sheet.getRange(1, 1, 1, HEADERS.length)
      .setFontWeight("bold")
      .setBackground("#1a1a2e")
      .setFontColor("#ffffff");
    sheet.setFrozenRows(1);

    if (!allBets || allBets.length === 0) return;

    // Issue 1 safety-net: exclude any UNKNOWN-typed bets that slipped through
    const betsToWrite = allBets.filter(bet => {
      const t = String(bet.type || bet.betType || "").toUpperCase().trim();
      return t !== "UNKNOWN" && t !== "";
    });

    const rows = betsToWrite.map((bet, i) => {
      // Inject source BEFORE flagBet — fleet bets have satellite_name but no .source,
      // so evaluateRow would fall to betSource='Totals' and miss leagueAssay keys.
      if (!bet.source) bet.source = bet.satellite_name || '';

      // Evaluate purity grade + status — try/catch so a throw never aborts the writer
      let flagResult = { bestGrade: '🜃 CHARCOAL', status: '—' };
      try {
        if (typeof Flagger_ !== 'undefined' && Flagger_.flagBet) {
          flagResult = Flagger_.flagBet(bet, edges, leagueAssay, teamAssay, matchupAssay) || flagResult;
        }
      } catch (e) { /* silent — grade stays CHARCOAL */ }

      const bestGrade = flagResult.bestGrade || flagResult.grade || '🜃 CHARCOAL';
      // Guarantee status is never blank — empty string from flagBet becomes '—'
      const status = (flagResult.status && String(flagResult.status).trim())
                     ? String(flagResult.status).trim() : '—';

      // Clean pick string — strip embedded confidence annotation markers that some
      // satellites embed inline: "Q2: A +9.0 ★ (75%) ★" → "Q2: A +9.0"
      const cleanedPick = String(bet.pick || '')
        .replace(/\s*[★●○◆▲▼]\s*\(\d+(?:\.\d+)?%\)\s*[★●○◆▲▼]?\s*/g, '')
        .replace(/\s*\(\d+(?:\.\d+)?%\)\s*/g, '')
        .trim();

      // Session 22g: derive Quarter and Direction from pick if missing from source sheet
      let derivedQuarter = bet.quarter != null ? bet.quarter : '';
      if (derivedQuarter === '' && typeof Parser_ !== 'undefined') {
        const parsedQ = Parser_.parseQuarter(cleanedPick);
        if (parsedQ != null) derivedQuarter = parsedQ;
      }

      let derivedDir = String(bet.direction || '').toUpperCase().trim();
      if (!derivedDir && typeof Parser_ !== 'undefined') {
        const parsedOU = Parser_.parseDirection(cleanedPick);
        if (parsedOU) {
          derivedDir = parsedOU.toUpperCase();
        } else {
          const parsedSide = Parser_.parseSide(cleanedPick, null);
          if (parsedSide === 'H') derivedDir = 'HOME';
          if (parsedSide === 'A') derivedDir = 'AWAY';
        }
      }

      // Derive backed team + opponent by bet type:
      //   Path 1: directional spread (SNIPER_MARGIN) — direction + home/away
      //   Path 2: BANKER / ROBBER — pick IS the team name directly
      //   Path 3: 1H_1X2 / FT_1X2 — pick may be HOME/AWAY/DRAW or a team name
      //   Path 4: OU / totals (SNIPER_OU, FT_O_U, SNIPER_HIGH_QTR) — no backed team
      const direction = derivedDir;
      const home      = String(bet.home      || '').trim();
      const away      = String(bet.away      || '').trim();
      const betType   = String(bet.type      || '').toUpperCase().trim();
      let backedTeam  = '';
      let opponent    = '';

      if (direction === 'HOME' && home) {
        // Path 1a: HOME direction
        backedTeam = home; opponent = away;
      } else if (direction === 'AWAY' && away) {
        // Path 1b: AWAY direction
        backedTeam = away; opponent = home;
      } else if (betType === 'BANKER' || betType === 'ROBBER') {
        // Path 2: pick is the team name — not a spread string
        const isSpreadPick = /^Q\d:|[+-]\d/.test(cleanedPick);
        if (!isSpreadPick && cleanedPick) {
          backedTeam = cleanedPick;
          // Session 22c fix: derive opponent for BANKER/ROBBER.
          // The pick is already the bare team name, so fuzzy-match directly against home/away.
          if (home && away) {
            const tU = cleanedPick.toUpperCase();
            const hU = home.toUpperCase();
            const aU = away.toUpperCase();
            if (hU.includes(tU) || tU.includes(hU)) { opponent = away; }
            else if (aU.includes(tU) || tU.includes(aU)) { opponent = home; }
          }
        }
      } else if (betType === '1H_1X2' || betType === 'FT_1X2' || betType === 'FIRST_HALF_1X2') {
        // Path 3: pick may be HOME/AWAY/DRAW label or a team name
        const pickUp = cleanedPick.toUpperCase();
        if      (pickUp === 'HOME' && home)  { backedTeam = home; opponent = away; }
        else if (pickUp === 'AWAY' && away)  { backedTeam = away; opponent = home; }
        else if (pickUp === 'DRAW')          { backedTeam = 'Draw'; }
        else if (cleanedPick) {
          backedTeam = cleanedPick;
          // Session 22b fix: derive opponent from home/away when pick encodes the team name.
          // Strip quarter prefix ("1H: ", "FT: ") and trailing spread notation ("(2.6)", "(-2.1)")
          // to isolate the team name, then fuzzy-match against home/away.
          if (home && away) {
            const teamName = cleanedPick
              .replace(/^(?:1H|2H|FT|Q\d)\s*:\s*/i, '')
              .replace(/\s*\([+-]?\d+(?:\.\d+)?\)\s*$/, '')
              .replace(/\s*[+-]\d+(?:\.\d+)?\s*$/, '')
              .trim()
              .toUpperCase();
            const hU = home.toUpperCase();
            const aU = away.toUpperCase();
            if (teamName && (hU.includes(teamName) || teamName.includes(hU))) {
              opponent = away;
            } else if (teamName && (aU.includes(teamName) || teamName.includes(aU))) {
              opponent = home;
            }
          }
        }
      }
      // Path 4: OU/totals — backedTeam stays blank (correct)

      // Matchup: match field from schema, then construct from home/away
      const matchup = bet.match || (home && away ? `${home} vs ${away}` : '');

      // Spread / Line: bet.line from schema first, then extract from cleaned pick.
      // Session 22 fix: also handles (X.X) and (-X.X) parens format used in 1H_1X2 picks
      // e.g. "1H: Kretinga (2.6)" → "2.6", "1H: Suduva-Mantinga (-2.1)" → "-2.1"
      const line = String(bet.line || '').trim()
        || (String(cleanedPick).match(/\(([+-]?\d+(?:\.\d+)?)\)\s*$/)?.[1] ?? '') // (2.6) or (-2.1)
        || (String(cleanedPick).match(/([+-]\d+(?:\.\d+)?)\s*$/)?.[1] ?? '');    // +4.5 or -3.0 bare

      // Result / Outcome — SCHEMA NOTE:
      //   parseIntakeMarketSheets (fleet bets): bet.result = 1/0/-1/null (integer)
      //   parseSideSheet:                       bet.result = 1/0/-1/null (integer)
      //   parseIntakeMarketSheets never sets bet.outcome
      //   MODULE 11 _buildRowObj_ sets bet.outcome — but those bets go through the
      //   bucket sheet path and arrive here as intake bets anyway (bet.result)
      // OUTCOME_MAP covers all known formats: integer, boolean string, word, emoji
      const OUTCOME_MAP = {
        // Integer convention confirmed from parseOutcome() (MODULE 07 lines 39/46/53):
        //   1 = WIN (return 1), 0 = LOSS (return 0), -1 = PUSH (return -1)
        '1':    '✅ HIT',   'true':   '✅ HIT',  'hit':  '✅ HIT',  'win':    '✅ HIT',  'w': '✅ HIT',
        '0':    '❌ MISS',  'false':  '❌ MISS', 'loss': '❌ MISS', 'miss':   '❌ MISS', 'l': '❌ MISS', 'lose': '❌ MISS',
        '-1':   '🟡 PUSH', 'push':   '🟡 PUSH', 'void': '🟡 PUSH', 'refund': '🟡 PUSH',
      };
      // Prefer bet.result (always set), fall back to bet.outcome (MODULE 11 path), then bet.actual
      const rawResult  = bet.result;
      const rawOutcome = bet.outcome;
      const rawActual  = bet.actual;
      let finalResult = '';
      // Coerce to string safely — handles null/undefined/boolean/number
      const toStr = v => (v === null || v === undefined) ? '' : String(v).trim();
      const resultStr  = toStr(rawResult);
      const outcomeStr = toStr(rawOutcome);
      const actualStr  = toStr(rawActual);
      // Try result first (covers 1/0/-1/WIN/LOSS/etc.)
      if (resultStr !== '') {
        if (resultStr.startsWith('✅') || resultStr.startsWith('❌') || resultStr.startsWith('🟡')) {
          finalResult = resultStr;
        } else {
          finalResult = OUTCOME_MAP[resultStr.toLowerCase()] || OUTCOME_MAP[resultStr] || resultStr;
        }
      }
      // Fallback: outcome string (MODULE 11 emoji path)
      if (!finalResult && outcomeStr !== '') {
        if (outcomeStr.startsWith('✅') || outcomeStr.startsWith('❌') || outcomeStr.startsWith('🟡')) {
          finalResult = outcomeStr;
        } else {
          finalResult = OUTCOME_MAP[outcomeStr.toLowerCase()] || OUTCOME_MAP[outcomeStr] || outcomeStr;
        }
      }
      // Last resort: actual score string
      if (!finalResult) finalResult = actualStr;

      // Conf Bucket — inline normalisation, no external function
      const rawBucket = String(bet.confBucket || bet.tier || '').trim().toUpperCase();
      let confBucket = rawBucket;
      if (rawBucket === '' || rawBucket === 'UNKNOWN') {
        confBucket = '';
      } else if (!['ELITE', 'STRONG', 'MEDIUM', 'EVEN', 'WEAK'].includes(rawBucket)) {
        const pctRe = /^[≥≤<>]?\d+(\.\d+)?[-–]?\d*(\.\d+)?%?$/;
        if (pctRe.test(rawBucket)) {
          confBucket = rawBucket; // already a valid pct-range string
        } else {
          const nb = parseFloat(rawBucket);
          if (!isNaN(nb) && nb >= 0 && nb <= 1) {
            const p = Math.round(nb * 100);
            confBucket = p >= 70 ? '≥70%' : p >= 65 ? '65-70%' : p >= 60 ? '60-65%' : p >= 55 ? '55-60%' : '<55%';
          } else if (!isNaN(nb) && nb > 1 && nb <= 100) {
            confBucket = nb >= 70 ? '≥70%' : nb >= 65 ? '65-70%' : nb >= 60 ? '60-65%' : nb >= 55 ? '55-60%' : '<55%';
          } else {
            confBucket = '';
          }
        }
      }

      return [
        i + 1,                                                     // Col 1:  Bet Index
        bet.satellite_name || bet.source || '',                    // Col 2:  Source
        bet.league         || '',                                  // Col 3:  League
        bet.date           || '',                                  // Col 4:  Date
        matchup,                                                   // Col 5:  Matchup
        cleanedPick,                                               // Col 6:  Pick (cleaned)
        bet.type           || '',                                  // Col 7:  Type
        derivedQuarter,                                            // Col 8:  Quarter
        derivedDir,                                                // Col 9:  Direction
        bet.confidence     || '',                                  // Col 10: Confidence
        confBucket,                                                // Col 11: Conf Bucket
        bestGrade,                                                 // Col 12: Grade
        status,                                                    // Col 13: Purity Status
        backedTeam,                                                // Col 14: Backed Team
        opponent,                                                  // Col 15: Opponent
        line,                                                      // Col 16: Spread / Line
        finalResult,                                               // Col 17: Result / Outcome
      ];
    });

    if (rows.length > 0) {
      sheet.getRange(2, 1, rows.length, HEADERS.length).setValues(rows);
    }

    // Auto-resize columns for readability
    for (let c = 1; c <= HEADERS.length; c++) {
      sheet.autoResizeColumn(c);
    }

    Logger.log(`[writeVaultFlat] Wrote ${rows.length} fleet records to "${SHEET_NAME}" (filtered ${allBets.length - betsToWrite.length} UNKNOWN).`);
  },

  writeVaultDashboard(ss, globalStats, leagueAssay, edges, teamAssay, matchupAssay, totalBetCount) {
    const SHEET_NAME = Config_.sheets.vaultDashboard || "MA_Vault_Dashboard";

    let sheet = ss.getSheetByName(SHEET_NAME);
    if (!sheet) {
      sheet = ss.insertSheet(SHEET_NAME);
    } else {
      sheet.clearContents();
      sheet.clearFormats();
    }

    this._renderVaultDashboardBody_(sheet, globalStats, leagueAssay, edges, teamAssay, matchupAssay, totalBetCount);

    Logger.log(`[writeVaultDashboard] Dashboard rendered to "${SHEET_NAME}".`);
  },

  _renderVaultDashboardBody_(sheet, globalStats, leagueAssay, edges, teamAssay, matchupAssay, totalBetCount) {
    if (teamAssay === undefined) teamAssay = {};
    if (matchupAssay === undefined) matchupAssay = {};
    if (!this.log) this.init();
    Log_.section("Writing Vault Dashboard Body");

    const now = Utils_.formatDate(new Date(), "yyyy-MM-dd HH:mm:ss");

    const safeGlobalWR =
      (globalStats && typeof globalStats.winRate === "number" && isFinite(globalStats.winRate)) ? globalStats.winRate : 0;
    const safePct = (v) => (typeof v === "number" && isFinite(v)) ? Stats_.pct(v) : "N/A";

    const globalGrade = Stats_.getGradeInfo(safeGlobalWR, globalStats ? globalStats.decisive || 0 : 0);

    const MAX_COLS = 10;
    const data = [];

    // Title
    data.push([`⚗️ MA ASSAYER VAULT — v${Config_.version}`, "", "", "", "", "", "", "", "", now]);
    data.push([""]);
    data.push(["═══════════════════════════════════════════════════════════════════"]);
    data.push(["📊 PURITY ASSESSMENT (Fleet-Only)"]);
    data.push([""]);

    // Fleet-only 2-column stats table
    const decisive  = globalStats ? globalStats.decisive  || 0 : 0;
    const wins      = globalStats ? globalStats.wins      || 0 : 0;
    const losses    = globalStats ? globalStats.losses    || 0 : 0;
    const totalParsed = (typeof totalBetCount === "number" && totalBetCount > 0)
      ? totalBetCount : (decisive + (globalStats ? globalStats.pushes || 0 : 0));
    const pending   = Math.max(0, totalParsed - decisive);
    const isReliable = decisive >= (Config_.thresholds.minNReliable || 100);

    data.push(["Metric", "Fleet (All)", "Grade", "Status"]);
    data.push(["Total Parsed",       totalParsed, "", ""]);
    data.push(["Decisive (Graded)",  decisive, `${globalGrade.symbol} ${globalGrade.name}`, isReliable ? "✅ Reliable" : "📊 Building"]);
    data.push(["Pending (No Result)",pending, "", ""]);
    data.push(["Wins",               wins,    "", ""]);
    data.push(["Losses",             losses,  "", ""]);
    data.push(["Win Rate",           safePct(safeGlobalWR), "", ""]);

    data.push([""]);
    data.push(["═══════════════════════════════════════════════════════════════════"]);
    data.push(["🔍 TOP DISCOVERED EDGES (Gold+)"]);
    data.push([""]);
    data.push(["Pattern", "Source", "Type", "N", "Win Rate", "Lift", "Grade"]);

    const topEdges = (Array.isArray(edges) ? edges : [])
      .filter(e => e.grade === "GOLD" || e.grade === "PLATINUM")
      .slice(0, Config_.report.maxEdgesToShow);

    if (topEdges.length === 0) {
      data.push(["No Gold/Platinum edges discovered yet"]);
    } else {
      topEdges.forEach(e => {
        // ◆ PATCH: Force display type for Side edges (display-only; does not mutate criteria)
        const typeKey =
          (e.source === "Side")
            ? "SNIPER_MARGIN"
            : ((e.criteria && e.criteria.typeKey) ? e.criteria.typeKey : "");

        data.push([e.name, e.source, typeKey, e.n, e.winRatePct, e.liftDisplay, `${e.gradeSymbol} ${e.grade}`]);
      });
    }

    // ── LEAGUES: TOP ──
    data.push([""]);
    data.push(["═══════════════════════════════════════════════════════════════════"]);
    data.push(["🏆 TOP LEAGUES BY PURITY (All-Quarter)"]);
    data.push([""]);
    data.push(["League", "Quarter", "Source", "Gender", "Tier", "Type", "N", "Win Rate", "Grade", "Status"]);

    const combos = Object.values(leagueAssay || {});
    const topCombos = combos
      .filter(l => (l ? l.quarter == null : false) && ((l ? l.decisive || 0 : 0) >= 5))
      .sort((a, b) => (b.shrunkRate || 0) - (a.shrunkRate || 0))
      .slice(0, Config_.report.maxLeaguesToShow);

    topCombos.forEach(l => {
      let status = "📊 Building";
      if (l.isToxic) status = "⚠️ Toxic";
      else if (l.isReliable) status = "✅ Reliable";
      else if (l.isElite) status = "🌟 Elite";

      data.push([
        l.league || "",
        l.quarterLabel || "All",
        l.source || "",
        l.gender || (l.isWomen ? "W" : "M"),
        l.tier || "UNKNOWN",
        l.typeKey || "",
        l.decisive || 0,
        Stats_.pct(l.shrunkRate || 0),
        `${l.gradeSymbol || ""} ${l.grade || ""}`.trim(),
        status
      ]);
    });

    // ── LEAGUES: LOW ──
    data.push([""]);
    data.push(["═══════════════════════════════════════════════════════════════════"]);
    data.push(["⛏️ LOW PERFORMING COMBINATIONS (All-Quarter)"]);
    data.push([""]);

    const lowCombos = combos
      .filter(l => (l ? l.quarter == null : false) && (l.grade === "CHARCOAL" || l.isToxic))
      .sort((a, b) => (a.shrunkRate || 0) - (b.shrunkRate || 0))
      .slice(0, Config_.report.maxToxicToShow);

    if (lowCombos.length === 0) {
      data.push(["No low-performing combinations identified"]);
    } else {
      data.push(["League", "Quarter", "Source", "Gender", "Tier", "Type", "N", "Win Rate", "Grade", "Action"]);
      lowCombos.forEach(l => {
        const action =
          l.grade === "CHARCOAL"
            ? "⛔ AVOID"
            : (l.isToxic ? "⚠️ REVIEW (Predefined)" : "⚠️ REVIEW");

        data.push([
          l.league || "",
          l.quarterLabel || "All",
          l.source || "",
          l.gender || (l.isWomen ? "W" : "M"),
          l.tier || "UNKNOWN",
          l.typeKey || "",
          l.decisive || 0,
          Stats_.pct(l.shrunkRate || 0),
          `${l.gradeSymbol || ""} ${l.grade || ""}`.trim(),
          action
        ]);
      });
    }

    // ── TEAMS: PLATINUM / GOLD ──
    const allTeams = Object.values(teamAssay || {});
    const allQuarterTeams = allTeams.filter(t => t.quarter == null);

    data.push([""]);
    data.push(["═══════════════════════════════════════════════════════════════════"]);
    data.push(["💎 TOP PLATINUM & GOLD TEAMS (All-Quarter, Side)"]);
    data.push([""]);
    data.push(["Team", "N", "Shrunk WR", "Lift", "Grade", "Status", "Leagues"]);

    const topTeams = allQuarterTeams
      .filter(t => t.grade === "PLATINUM" || t.grade === "GOLD")
      .sort((a, b) => (b.shrunkRate || 0) - (a.shrunkRate || 0))
      .slice(0, 12);

    if (topTeams.length === 0) {
      data.push(["No Platinum/Gold teams yet"]);
    } else {
      topTeams.forEach(t => {
        const status = t.isElite ? "🌟 Elite" : (t.isReliable ? "✅ Reliable" : "📊 Building");
        data.push([
          t.team || "",
          t.decisive || 0,
          Stats_.pct(t.shrunkRate || 0),
          Stats_.lift(t.lift || 0),
          `${t.gradeSymbol || ""} ${t.grade || ""}`.trim(),
          status,
          Array.isArray(t.leagues) ? t.leagues.slice(0, 4).join(", ") : ""
        ]);
      });
    }

    // ── TEAMS: CHARCOAL / TOXIC ──
    data.push([""]);
    data.push(["═══════════════════════════════════════════════════════════════════"]);
    data.push(["⛔ CHARCOAL TEAMS TO AVOID (All-Quarter, Side)"]);
    data.push([""]);

    const charcoalTeams = allQuarterTeams
      .filter(t => t.grade === "CHARCOAL" || t.isToxic)
      .sort((a, b) => (a.shrunkRate || 0) - (b.shrunkRate || 0))
      .slice(0, 12);

    if (charcoalTeams.length === 0) {
      data.push(["No Charcoal teams identified"]);
    } else {
      data.push(["Team", "N", "Shrunk WR", "Lift", "Grade", "Action", "Leagues"]);
      charcoalTeams.forEach(t => {
        const action = t.isToxic ? "⚠️ REVIEW (Config)" : "⛔ AVOID";
        data.push([
          t.team || "",
          t.decisive || 0,
          Stats_.pct(t.shrunkRate || 0),
          Stats_.lift(t.lift || 0),
          `${t.gradeSymbol || ""} ${t.grade || ""}`.trim(),
          action,
          Array.isArray(t.leagues) ? t.leagues.slice(0, 4).join(", ") : ""
        ]);
      });
    }

    // ── MATCHUP COUNT ──
    const matchupCount = Object.keys(matchupAssay || {}).length;
    if (matchupCount > 0) {
      data.push([""]);
      data.push(["═══════════════════════════════════════════════════════════════════"]);
      data.push([`💠 ${matchupCount} Matchups analyzed (see MA_MatchupAssay tab)`]);
    }

    // ── FOOTER ──
