function clearLogs() { 
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(Config_.sheets.logs);
  if (sheet) sheet.clear();
}

/**
 * runSheetInspector — Reads all assayer output sheets and writes a
 * comprehensive bug report to MA_Inspector. No imports needed.
 * Run directly from Apps Script editor (or menu) after runAssay() completes.
 */
function runSheetInspector() {
  const ss     = SpreadsheetApp.getActiveSpreadsheet();
  const report = [];  // array of { sheet, row, col, value, issue }
  const counts = {};  // sheet → { total, issues }

  function flag(sheetName, rowNum, colName, value, issue) {
    report.push({ sheet: sheetName, row: rowNum, col: colName,
                  value: String(value).slice(0, 80), issue });
  }

  function readSheet(name) {
    const sh = ss.getSheetByName(name);
    if (!sh || sh.getLastRow() < 1) return { headers: [], rows: [], sh: null };
    const lastRow = sh.getLastRow();
    const lastCol = sh.getLastColumn();
    if (lastCol < 1) return { headers: [], rows: [], sh };
    const raw     = sh.getRange(1, 1, lastRow, lastCol).getValues();
    const headers = raw[0].map(h => String(h).trim());
    const rows    = raw.slice(1);
    return { headers, rows, sh, lastRow: lastRow - 1 };
  }

  // ═══════════════════════════════════════════════
  // 1. MA_VAULT
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_Vault...');
  (function() {
    const SHEET = 'MA_Vault';
    const { headers, rows } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY — runAssay may not have fired'); counts[SHEET].issues++; return; }

    const EXP = ['Bet Index (rowIndex)','Source','League','Date','Matchup','Pick',
                 'Type','Confidence','Conf Bucket','Grade','Purity Status',
                 'Backed Team','Opponent','Spread / Line','Result / Outcome'];
    EXP.forEach((h,i) => {
      if (headers[i] !== h) flag(SHEET,0,'Col '+(i+1),headers[i],'Header mismatch — expected "'+h+'"');
    });

    const VALID_TIERS   = ['ELITE','STRONG','MEDIUM','EVEN','WEAK',''];
    const VALID_RESULTS = [
      'WIN','LOSS','PUSH','W','L','P','','—','-',
      // _normalizeOutcome_ in MODULE 11 maps outcomes to emoji strings
      '✅ HIT','❌ MISS','🟡 PUSH',
      // Also accept raw pass-throughs that _normalizeOutcome_ returns as-is
      'HIT','MISS','VOID','REFUND'
    ];
    const VALID_TYPES   = ['SNIPER_MARGIN','SNIPER_OU','1H_1X2','FT_O_U',
                           'SNIPER_HIGH_QTR','BANKER','ROBBER','FT_1X2','FIRST_HALF_1X2'];
    // Conf Bucket: valid if it's a tier name, a pct-range string, OR blank (UNKNOWN bets → empty).
    // normaliseConfBucket output examples: "", "55-60%", "<55%", "≥70%", "65-70%", "ELITE"
    const PCT_RANGE_RE  = /^[≥≤<>]?\d+(\.\d+)?[-–]?\d*(\.\d+)?%?$/;

    let blankSource=0,blankMatchup=0,blankGrade=0,unknownType=0,
        blankResult=0,blankBacked=0,blankLeague=0,unexpectedType=0,
        badConfBucket=0;

    rows.forEach((row, ri) => {
      const rowNum  = ri + 2;
      const source  = String(row[1]  || '').trim();
      const league  = String(row[2]  || '').trim();
      const matchup = String(row[4]  || '').trim();
      const type    = String(row[6]  || '').trim().toUpperCase();
      const confBkt = String(row[8]  || '').trim().toUpperCase();
      const grade   = String(row[9]  || '').trim();
      const backed  = String(row[11] || '').trim();
      const result  = String(row[14] || '').trim().toUpperCase();

      if (!source)  blankSource++;
      if (!league)  blankLeague++;
      if (!matchup) blankMatchup++;
      if (type === 'UNKNOWN') unknownType++;
      else if (type && !VALID_TYPES.includes(type)) {
        unexpectedType++;
        if (unexpectedType <= 3) flag(SHEET,rowNum,'Type',type,'Unrecognised bet type');
      }
      if (!grade)   blankGrade++;
      if (!backed)  blankBacked++;
      if (!VALID_RESULTS.includes(result)) blankResult++;
      // Conf Bucket: accept tier names OR pct-range strings like "55-60%", "≥70%"
      if (confBkt && !VALID_TIERS.includes(confBkt) && !PCT_RANGE_RE.test(confBkt)) {
        badConfBucket++;
      }
    });

    const n = rows.length;
    if (blankSource    > 0) flag(SHEET,0,'Source',     '',blankSource+'/'+n+' rows have blank Source');
    if (blankLeague    > 0) flag(SHEET,0,'League',     '',blankLeague+'/'+n+' rows have blank League');
    if (blankMatchup   > 0) flag(SHEET,0,'Matchup',    '',blankMatchup+'/'+n+' rows have blank Matchup');
    if (unknownType    > 0) flag(SHEET,0,'Type',       '',unknownType+'/'+n+' rows still have type=UNKNOWN');
    if (unexpectedType > 3) flag(SHEET,0,'Type',       '',(unexpectedType-3)+' more rows have unrecognised type (first 3 flagged individually)');
    if (blankGrade     > 0) flag(SHEET,0,'Grade',      '',blankGrade+'/'+n+' rows have blank Grade');
    // Blank backed team is EXPECTED for OU/over-under bets — INFO only, never flag
    if (blankBacked    > 0) Logger.log('[Inspector] MA_Vault: '+blankBacked+'/'+n+' blank Backed Team — expected for OU bets');
    // Blank results are expected for pending/future bets — only flag if >80% are blank
    if (blankResult > n * 0.80) {
      flag(SHEET,0,'Result','',blankResult+'/'+n+' rows have blank Result — exceeds 80% threshold, possible writer bug');
    } else if (blankResult > 0) {
      Logger.log('[Inspector] MA_Vault: '+blankResult+'/'+n+' blank results — within expected range for pending bets');
    }
    if (badConfBucket  > 0) flag(SHEET,0,'Conf Bucket','',badConfBucket+'/'+n+' rows have conf bucket that is neither a tier name nor a pct range');

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] MA_Vault: '+n+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 2. MA_LeagueAssay
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_LeagueAssay...');
  (function() {
    const SHEET = 'MA_LeagueAssay';
    const { headers, rows } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY'); counts[SHEET].issues++; return; }

    const VALID_TIERS = ['ELITE','STRONG','MEDIUM','EVEN','WEAK','ALL','UNKNOWN',''];
    const tierIdx     = headers.indexOf('Tier');
    const nIdx        = Math.max(headers.indexOf('N'), headers.indexOf('n'), 5);
    // Header is 'Raw WR' (or 'Shrunk WR') not 'Win Rate' — find the right column
    const wrIdx = (() => {
      const candidates = ['Raw WR', 'Shrunk WR', 'Win Rate'];
      for (const c of candidates) {
        const i = headers.indexOf(c);
        if (i >= 0) return i;
      }
      return 9; // fallback: col 10 (0-indexed 9) = Raw WR position
    })();
    const gradeIdx    = Math.max(headers.indexOf('Grade'), 14);

    let noTier=0,zeroN=0,missingLeague=0,winRateOOB=0;
    rows.forEach(row => {
      const league  = String(row[0]||'').trim();
      const tier    = String(tierIdx>=0 ? row[tierIdx] : row[2]||'').trim().toUpperCase();
      const n       = Number(row[nIdx]||0);
      // Win rate may be stored as a decimal (0.552) or as a formatted pct string ("55.20%")
      // Read the raw cell value — Sheets returns the numeric value even for % formatted cells
      const wrRaw   = row[wrIdx];
      const winRate = typeof wrRaw === 'number' ? wrRaw : parseFloat(String(wrRaw||'').replace('%','')) / 100;
      if (!league) missingLeague++;
      if (tier && !VALID_TIERS.includes(tier)) noTier++;
      if (n === 0) zeroN++;
      // After fix: winRate stored as decimal; allow [0,1]. If still > 1 it means pct not fixed yet.
      if (winRate < 0 || winRate > 1.001) winRateOOB++;
    });

    const n = rows.length;
    if (missingLeague > 0) flag(SHEET,0,'League',  '',missingLeague+'/'+n+' rows missing league');
    if (noTier        > 0) flag(SHEET,0,'Tier',    '',noTier+'/'+n+' rows have unrecognised tier');
    if (zeroN         > 0) flag(SHEET,0,'N',       '',zeroN+'/'+n+' rows have N=0 (empty sample)');
    if (winRateOOB    > 0) flag(SHEET,0,'Win Rate','',winRateOOB+'/'+n+' rows have win rate outside [0,1]');

    const hasElite = rows.some(r => String(tierIdx>=0 ? r[tierIdx] : r[2]||'').toUpperCase() === 'ELITE');
    if (!hasElite) flag(SHEET,0,'Tier','','[INFO] No ELITE tier rows — expected if no satellite bet has confidence ≥70%, or assay run before parseTier fix was deployed');

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] MA_LeagueAssay: '+n+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 3. MA_TeamAssay
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_TeamAssay...');
  (function() {
    const SHEET = 'MA_TeamAssay';
    const { rows } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY'); counts[SHEET].issues++; return; }

    const SYNTHETIC = ['HIGHEST Q','HIGHEST SCORING','HIGHEST QUARTER',
                       'HIGH QUARTER','HIGH QTR','HIGHEST QTR'];
    // Shrunk WR is col index 5 in the TeamAssay sheet
    // (Team=0, Quarter=1, N=2, Wins=3, Losses=4, Shrunk WR=5)
    const { headers: teamHeaders } = readSheet(SHEET);
    const shrunkIdx = teamHeaders.indexOf('Shrunk WR') >= 0 ? teamHeaders.indexOf('Shrunk WR') : 5;

    let synth=0,zeroN=0,badWR=0;
    rows.forEach(row => {
      const team = String(row[0]||'').trim().toUpperCase();
      const n    = Number(row[2]||0);
      const wrRaw   = row[shrunkIdx];
      const winRate = typeof wrRaw === 'number' ? wrRaw : parseFloat(String(wrRaw||'').replace('%','')) / 100;
      if (SYNTHETIC.some(s=>team.includes(s)) || team.startsWith('HIGHEST') || team.startsWith('HIGH Q')) synth++;
      if (n===0) zeroN++;
      if (winRate<0 || winRate>1.001) badWR++;
    });

    const n = rows.length;
    if (synth > 0) flag(SHEET,0,'Team','',synth+' synthetic/pseudo-team rows still present (HIGHEST Q etc)');
    if (zeroN > 0) flag(SHEET,0,'N',   '',zeroN+'/'+n+' rows have N=0');
    if (badWR > 0) flag(SHEET,0,'WR',  '',badWR+'/'+n+' rows have win rate outside [0,1]');

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] MA_TeamAssay: '+n+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 4. MA_MatchupAssay
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_MatchupAssay...');
  (function() {
    const SHEET = 'MA_MatchupAssay';
    const { rows } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY'); counts[SHEET].issues++; return; }

    let blankKey=0,zeroN=0;
    rows.forEach(row => {
      if (!String(row[0]||'').trim()) blankKey++;
      if (Number(row[2]||0)===0) zeroN++;
    });

    const n = rows.length;
    if (blankKey > 0) flag(SHEET,0,'Matchup Key','',blankKey+'/'+n+' rows have blank matchup key');
    if (zeroN    > 0) flag(SHEET,0,'N',          '',zeroN+'/'+n+' rows have N=0');

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] MA_MatchupAssay: '+n+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 5. ASSAYER_EDGES
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking ASSAYER_EDGES...');
  (function() {
    const SHEET = 'ASSAYER_EDGES';
    const { headers, rows } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY — no edges discovered'); counts[SHEET].issues++; return; }

    let blankEdge=0,badWR=0;
    rows.forEach(row => {
      if (!String(row[0]||'').trim()) blankEdge++;
      const wr=Number(row[5]||0);
      if (wr<0||wr>1.001) badWR++;
    });

    // Count completely empty rows (all cells blank/zero) as a real problem
    const emptyRows = rows.filter(r => r.every(c => c === '' || c === 0));

    const n = rows.length;
    if (blankEdge    > 0) flag(SHEET,0,'Edge ID', '',blankEdge+'/'+n+' edges missing ID');
    if (emptyRows.length > 0) flag(SHEET,0,'Row',   '',emptyRows.length+' completely empty edge rows found');
    if (badWR        > 0) flag(SHEET,0,'Win Rate','',badWR+'/'+n+' edges have win rate outside [0,1]');

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] ASSAYER_EDGES: '+n+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 6. ASSAYER_LEAGUE_PURITY
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking ASSAYER_LEAGUE_PURITY...');
  (function() {
    const SHEET = 'ASSAYER_LEAGUE_PURITY';
    const { headers, rows } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY'); counts[SHEET].issues++; return; }

    let blankLeague=0,zeroN=0,badWR=0;
    rows.forEach(row => {
      if (!String(row[0]||'').trim()) blankLeague++;
      if (Number(row[1]||0)===0) zeroN++;
      const wr=Number(row[5]||0);
      if (wr<0||wr>1.001) badWR++;
    });

    const n = rows.length;
    if (blankLeague > 0) flag(SHEET,0,'League',  '',blankLeague+'/'+n+' rows missing league');
    if (zeroN       > 0) flag(SHEET,0,'N',       '',zeroN+'/'+n+' rows have N=0');
    if (badWR       > 0) flag(SHEET,0,'Win Rate','',badWR+'/'+n+' rows have win rate outside [0,1]');

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] ASSAYER_LEAGUE_PURITY: '+n+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 7. MA_Discovery
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_Discovery...');
  (function() {
    const SHEET = 'MA_Discovery';
    const { headers, rows } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY'); counts[SHEET].issues++; return; }

    let blankId=0,blankGrade=0,zeroScore=0;
    rows.forEach(row => {
      if (!String(row[0]||'').trim()) blankId++;
      if (!String(row[9]||'').trim()) blankGrade++;
      if (Number(row[15]||0)===0) zeroScore++;
    });

    const n = rows.length;
    if (blankId    > 0) flag(SHEET,0,'Edge ID',   '',blankId+'/'+n+' edges missing ID');
    if (blankGrade > 0) flag(SHEET,0,'Grade',     '',blankGrade+'/'+n+' edges missing grade');
    if (zeroScore  > 0) flag(SHEET,0,'Edge Score','',zeroScore+'/'+n+' edges have score=0');

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] MA_Discovery: '+n+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 8. MA_Summary
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_Summary...');
  (function() {
    const SHEET = 'MA_Summary';
    const { rows, sh } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!sh) { flag(SHEET,0,'—','','Sheet does not exist'); counts[SHEET].issues++; return; }
    if (rows.length < 3) { flag(SHEET,0,'—','','Sheet appears empty or malformed (<3 data rows)'); counts[SHEET].issues++; return; }

    const text = rows.map(r=>r.join(' ')).join('\n').toUpperCase();
    // BY TYPE (Fleet) replaces old BY SOURCE — check for fleet bet type keywords
    if (!text.includes('FLEET') && !text.includes('SNIPER') && !text.includes('BANKER') &&
        !text.includes('BY TYPE') && !text.includes('ROBBER')) {
      flag(SHEET,0,'BY TYPE','','Fleet bet type breakdown missing from MA_Summary — check writeSummary in MODULE 01');
    }

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] MA_Summary: '+rows.length+' rows, '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 9. MA_Vault_Dashboard
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_Vault_Dashboard...');
  (function() {
    const SHEET = 'MA_Vault_Dashboard';
    const { rows, sh } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!sh) { flag(SHEET,0,'—','','Sheet does not exist'); counts[SHEET].issues++; return; }

    const text = rows.map(r=>r.join('|')).join('\n');
    if (text.includes('Side/Classic') || text.includes('Totals/Classic')) {
      flag(SHEET,0,'Headers','','Old Side/Classic or Totals/Classic columns still present');
    }
    if (!text.toLowerCase().includes('fleet')) {
      flag(SHEET,0,'Headers','','Fleet (All) column not found in dashboard');
    }
    if (!text.includes('Total Parsed') && !text.includes('Decisive')) {
      flag(SHEET,0,'Rows','','Total Parsed / Decisive rows missing from PURITY ASSESSMENT table');
    }

    counts[SHEET].issues = report.filter(r=>r.sheet===SHEET).length;
    Logger.log('[Inspector] MA_Vault_Dashboard: '+counts[SHEET].issues+' issue(s)');
  })();

  // ═══════════════════════════════════════════════
  // 10. MA_Exclusion
  // ═══════════════════════════════════════════════
  Logger.log('[Inspector] Checking MA_Exclusion...');
  (function() {
    const SHEET = 'MA_Exclusion';
    const { rows, sh } = readSheet(SHEET);
    counts[SHEET] = { total: rows.length, issues: 0 };
    if (!sh) { flag(SHEET,0,'—','','Sheet does not exist — writeExclusionImpact may not have run'); counts[SHEET].issues++; return; }
    if (!rows.length) { flag(SHEET,0,'—','','Sheet is EMPTY'); counts[SHEET].issues++; return; }
    Logger.log('[Inspector] MA_Exclusion: '+rows.length+' rows, OK');
  })();

  // ═══════════════════════════════════════════════
  // WRITE MA_Inspector REPORT SHEET
  // ═══════════════════════════════════════════════
  const REPORT_SHEET = 'MA_Inspector';
  let rsh = ss.getSheetByName(REPORT_SHEET);
  if (!rsh) rsh = ss.insertSheet(REPORT_SHEET);
  else rsh.clearContents();

  const ts          = new Date().toISOString();
  const totalIssues = report.length;
  const passing     = Object.entries(counts).filter(([,v])=>v.issues===0).length;
  const failing     = Object.entries(counts).filter(([,v])=>v.issues>0).length;
  const overall     = totalIssues===0 ? '✅ ALL CLEAN' : '❌ '+totalIssues+' ISSUE(S) FOUND';

  const headerRows = [
    ['MA_Inspector — Assayer Sheet Audit Report','','','',''],
    ['Generated',ts,'','',''],
    ['Overall',overall,'','',''],
    ['Sheets checked',Object.keys(counts).length,'','',''],
    ['Sheets passing',passing,'','',''],
    ['Sheets with issues',failing,'','',''],
    ['','','','',''],
    ['── SHEET SUMMARY ──','','','',''],
    ['Sheet','Rows','Issues','',''],
    ...Object.entries(counts).map(([name,v])=>[
      name, v.total, v.issues===0 ? '✅ Clean' : '❌ '+v.issues+' issue(s)','',''
    ]),
    ['','','','',''],
    ['── DETAILED FINDINGS ──','','','',''],
    ['Sheet','Row','Column/Field','Value','Issue Description'],
  ];

  const detailRows = report.length>0
    ? report.map(r=>[r.sheet, r.row||'—', r.col, r.value, r.issue])
    : [['—','—','—','—','No issues found — all sheets are clean ✅']];

  const allRows = [...headerRows, ...detailRows];
  rsh.getRange(1,1,allRows.length,5).setValues(allRows);

  // Style header rows
  rsh.getRange(1,1,1,5).merge()
    .setFontWeight('bold').setFontSize(13)
    .setBackground('#0d1117').setFontColor('#58a6ff');
  rsh.getRange(3,1,1,2)
    .setFontWeight('bold')
    .setBackground(totalIssues===0 ? '#1a4731' : '#4a1010')
    .setFontColor('#ffffff');
  rsh.getRange(9,1,1,3).setFontWeight('bold').setBackground('#1a1a2e').setFontColor('#ffffff');
  const detailHeaderRow = headerRows.length;
  rsh.getRange(detailHeaderRow,1,1,5).setFontWeight('bold').setBackground('#1a1a2e').setFontColor('#ffffff');
  rsh.autoResizeColumns(1,5);

  Logger.log('══════════════════════════════════');
  Logger.log('[Inspector] COMPLETE: '+overall);
  Logger.log('[Inspector] Report written to MA_Inspector');
  Logger.log('══════════════════════════════════');

  try {
    SpreadsheetApp.getUi().alert(
      'MA Inspector Complete\n\n'+overall+'\n\nSee MA_Inspector sheet for full details.'
    );
  } catch(e) {} // suppress alert if running headless
}
