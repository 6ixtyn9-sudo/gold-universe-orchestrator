function runFleetImportResume() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2000)) {
    console.warn("Could not acquire script lock. Exiting early.");
    return;
  }
  try {
  // Cancel the trigger that fired us so it doesn't stack
  FleetImport_._cancelResumeTimer_();
  Log_.init();
  const ss  = SpreadsheetApp.getActiveSpreadsheet();
  const log = Log_.module('FLEET_IMPORT');
  const done = FleetImport_.importAccuracyReports_(ss, { resume: true }, log);
  if (done !== false) {
    // ── BUG FIX: read FI_CHAIN_ASSAY BEFORE cleanResumeTriggers_() deletes it ──
    const shouldChainAssay = PropertiesService.getScriptProperties().getProperty('FI_CHAIN_ASSAY') === 'true';

    // Completed — cancel any leftover timer and clean properties
    FleetImport_.cleanResumeTriggers_();

    // Chain into runAssay if this run was launched via runFleetImportAndAssay
    if (shouldChainAssay) {
      log.info('Fleet import finished on resume. Launching assay...');
      log.info('══════════════════════════════════════');
      log.info('HANDOFF → launching Main_.runAssay()');
      log.info('══════════════════════════════════════');
      Log_.writeToSheet(ss);
      Main_.runAssay();
      return;
    }
  }
  Log_.writeToSheet(ss);
  } finally {
    lock.releaseLock();
  }
}

function resetFleetImport() {
  FleetImport_.cleanResumeTriggers_();
  Logger.log('FleetImport resume state + timer cleared.');
}

function purgeSatelliteAction() {
  const ui = SpreadsheetApp.getUi();
  const response = ui.prompt('Purge Satellite', 'Enter the exact Satellite ID to remove from intake tabs:', ui.ButtonSet.OK_CANCEL);
  if (response.getSelectedButton() === ui.Button.OK) {
    const id = response.getResponseText().trim();
    if (id) {
