      const ss = SpreadsheetApp.getActiveSpreadsheet();
      FleetImport_.purgeSatellite(ss, id, null);
      Log_.writeToSheet(ss);
      ui.alert('Purge complete. Check MA_Logs for details.');
    }
  }
}

