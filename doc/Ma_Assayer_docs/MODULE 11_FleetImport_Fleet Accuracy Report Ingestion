function clearAllIntakeData() {
  FleetImport_._cancelResumeTimer_();

  const props = PropertiesService.getScriptProperties();
  props.deleteProperty(FleetImport_.PROP_RESUME_IDX);
  props.deleteProperty(FleetImport_.PROP_RUN_ID);

  const ss      = SpreadsheetApp.getActiveSpreadsheet();
  const log     = Log_.module ? Log_.module('CLEAR') : console;
  const sheets  = ss.getSheets();
  const cleared = [];

  sheets.forEach(sh => {
    const name = sh.getName();
    if (
      FleetImport_.MANAGED_SHEET_RE.test(name) &&
      !FleetImport_.PROTECTED_SHEETS.has(name) &&
      name !== 'MA_ImportReport'
    ) {
      sh.clearContents();
      cleared.push(name);
    }
  });

  Logger.log(`clearAllIntakeData: cleared ${cleared.length} sheets — ${cleared.join(', ')}`);
  if (log.info) log.info(`Cleared ${cleared.length} intake sheets. Resume state reset.`);
}


// ─────────────────────────────────────────────────────────────────────────────
// DIAGNOSTIC: count every unique type value in the UNKNOWN sheet.
// Run once from the editor — results appear in the execution log.
// Paste the sanitized values into TYPE_CANONICAL to eliminate UNKNOWN rows.
// ─────────────────────────────────────────────────────────────────────────────

function auditUnknownTypes() {
  // Reads the raw-type tracker built during import (not the sheet)
  // so you see the ORIGINAL satellite type strings, not "UNKNOWN"
  const props = PropertiesService.getScriptProperties();
  const stored = props.getProperty(FleetImport_.PROP_UNKNOWN_TYPES);
  if (!stored) {
    Logger.log('No unknown type data recorded yet. Run a fleet import first.');
    return;
  }
  const counts = JSON.parse(stored);
  const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
  const total  = sorted.reduce((s, [,n]) => s + n, 0);

  Logger.log('==== UNKNOWN raw type audit (' + total + ' rows, ' + sorted.length + ' unique types) ====');
  sorted.forEach(function([type, n]) {
    const sanitized = type.toUpperCase()
      .replace(/[^A-Z0-9]/g, '_')
      .replace(/_+/g, '_')
      .replace(/^_|_$/g, '')
      .slice(0, 25);
    Logger.log('  ' + String(n).padStart(4) + 'x  "' + type + '"  =>  sanitized: "' + sanitized + '"');
  });
  Logger.log('==== Paste the sanitized keys into TYPE_CANONICAL to resolve. ====');
}


// ─── DEV ONLY: Retry Simulation ───────────────────────────────────────────
function DEV_simulateRetry() {
  const log = Log_.module('DEV_TEST');
  let throwCount = 0;
  log.info('Starting dev retry simulation...');
  try {
    const result = FleetImport_.withRetry_(() => {
      throwCount++;
      if (throwCount <= 2) {
        throw new Error('Service Spreadsheets timed out while accessing document');
      }
      return 'SUCCESS';
    }, 'simulate_openById', log, { attempts: 4, baseMs: 100, maxMs: 1000 });
    log.info(`Final result: ${result}`);
  } catch (e) {
    log.error(`Failed: ${e.message}`);
  }
}
